{
  "name": "deskviewer",
  "productName": "DeskViewer",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop remote viewer app",
  "author": "Your Name <youremail@example.com>",
  "main": "public/electron.js",
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "electron-start": "electron .",
    "start": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && electron .\"",
    "dist": "npm run react-build && electron-builder --win --x64",
    "postinstall": "electron-builder install-app-deps",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@reduxjs/toolkit": "^1.9.3",
    "moment": "^2.29.4",
    "peerjs": "^1.4.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.8.0",
    "react-redux": "^8.0.5",
    "react-router-dom": "^6.7.0",
    "react-scripts": "5.0.1",
    "react-toastify": "^9.1.1",
    "socket.io-client": "^4.6.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "electron": "^23.1.3",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^2.0.0",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "tailwindcss": "^3.2.7"
  },
  "build": {
    "appId": "com.deskviewer.app",
    "productName": "DeskViewer",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "build/**/*",
      "electron.js",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "DeskViewer-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "runAfterFinish": true
    }
  },
  "eslintConfig": {
    "extends": ["react-app", "react-app/jest"]
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  }
}